# No real credentials here. `npm run provision` generates private .dev/ files.
# Default public endpoints are loopback only; fixed local chain ID is 31337.
PORT=4300
SIGNER_ID=signer-1
# QUORUM_DEV=.dev
# QUORUM_NATIVE=.build/quorum-signer
# QUORUM_NO_WORKER=1
# QUORUM_DEMO_CONTROLS=1  # opt in only during fresh local provisioning
# QUORUM_RECOVERY_PASSWORD_FILE=/absolute/path/to/private-password-file
