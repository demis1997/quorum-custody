    "recovery": "tsx scripts/recovery.ts",
    "resilience": "tsx tests/resilience.ts"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "pg": "8.23.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "fast-check": "4.3.0",
    "playwright": "1.55.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.20.0 <23"
