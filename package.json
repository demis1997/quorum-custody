{
  "name": "quorum-custody",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "integration": "tsx tests/integration.ts",
    "api": "tsx src/api.ts",
    "signer": "tsx src/signer.ts",
    "provision": "tsx scripts/provision.ts",
    "demo": "tsx scripts/demo.ts",
    "lint": "eslint src scripts tests ui",
